// Generates src/logic/ranges/ranking.ts: the 169 starting hands sorted by equity against
// one random hand, computed with PokerToolBox's own equity engine.
// Run with: npx tsx scripts/generate-ranking.mts
import { writeFileSync } from 'node:fs';
import { calculateEquity, seededRandom } from '../src/logic/equity';
import { ALL_HANDS, combosOf } from '../src/logic/ranges/combos';

const SAMPLES = 60_000;
const random = seededRandom(169);

const rows = ALL_HANDS.map((hand) => {
  const [a, b] = combosOf(hand)[0].cards;
  const r = calculateEquity({ players: [[a, b], [null, null]], board: [] }, { samples: SAMPLES, random });
  return { hand, equity: r.players[0].equity };
}).sort((x, y) => y.equity - x.equity);

const body = rows.map((r) => `  ['${r.hand}', ${r.equity.toFixed(4)}],`).join('\n');
const file = `// Generated by scripts/generate-ranking.mts — do not edit by hand.
// The 169 starting hands sorted by all-in equity against one random hand
// (${SAMPLES.toLocaleString('en-US')} Monte Carlo samples per hand, seed 169).
export const HAND_RANKING: [hand: string, equity: number][] = [
${body}
];
`;
writeFileSync(new URL('../src/logic/ranges/ranking.ts', import.meta.url), file);
console.log('top 10:', rows.slice(0, 10).map((r) => `${r.hand} ${(r.equity * 100).toFixed(1)}%`).join(', '));
console.log('bottom 3:', rows.slice(-3).map((r) => `${r.hand} ${(r.equity * 100).toFixed(1)}%`).join(', '));
